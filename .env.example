# Configuracion de la conexion a PostgreSQL para el ETL.
#
# Copiar este archivo a .env y completar los valores:
#     copy .env.example .env
#
# El archivo .env esta en .gitignore. NO subirlo nunca al repositorio:
# es el unico lugar del proyecto donde vive una clave real.
#
# La clave de secop_etl no se inventa: es la que se creo en la sesion 1
# con sql/00_instalacion.sql, y la misma que esta en las conexiones de
# DBeaver (secop_etl y secop_lectura).

PGHOST=localhost
PGPORT=5432
PGDATABASE=secop_integrado

# Rol de escritura: Dueeno de los esquemas staging, silver y gold.
PGUSER=secop_etl
PGPASSWORD=

# Rol de solo lectura. Solo ve el esquema gold.
# Sirve para probar que el modelo respeta los permisos.
# Descomentar si se va a usar:
# PGUSER_CONSULTA=secop_lectura
# PGPASSWORD_CONSULTA=
